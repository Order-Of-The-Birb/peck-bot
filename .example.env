bot_token=
management_token=
api_url=http://127.0.0.1:8001/
WT_LOGIN_EMAIL=
WT_LOGIN_PASS=

# Run `python -m modules.peck_data` as a separate supervised process that does not load this file.
# Keep the data service private. If the bot runs in a container, check the URL from inside that container.
# Before starting the bot, verify /healthz returns {"service":"peck-data"}, then check the actual lookups:
# curl -fsS 'http://127.0.0.1:5001/v1/sqb/today?timezone=UTC'  (look for br_status=available in season)
# curl -fsS 'http://127.0.0.1:5001/v1/vehicles/br?vehicle=BMP-T'  (look for status=ok)
# Set the Airbot Chat Completions base URL (ending in /v1) to enable @Peckbot questions.
PECK_AI_BASE_URL=
PECK_AI_MODEL=gemma-4-heretic
PECK_DATA_API_URL=http://127.0.0.1:5001
